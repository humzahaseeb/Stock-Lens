# Financial Modeling Prep API key (free tier: https://financialmodelingprep.com/developer/docs)
FMP_API_KEY=

# Finnhub API key (free tier: https://finnhub.io/register) — used for real
# analyst recommendation trends and insider sentiment. Free tier coverage is
